{
  "name": "stereogram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free stereogram (Magic Eye) generator in the browser: shapes, text, a drawn or uploaded depth map; random dots or a pattern; print-size PNG; no account.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-plates.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "contrast": "node scripts/contrast-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  }
}
